# ---- Fase 0 (em uso) ----
POSTGRES_USER=multicortex
POSTGRES_PASSWORD=multicortex
POSTGRES_DB=multicortex_crm
DATABASE_URL=postgresql://multicortex:multicortex@postgres:5432/multicortex_crm?schema=public

BACKEND_PORT=3333
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
APP_DOMAIN=localhost
NODE_ENV=development

# ---- Fase 1 (em uso) ----
# Token opaco de refresh nao usa JWT nem segredo proprio (guardado com hash no banco).
JWT_SECRET=troque-este-valor-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Fase 3 (em uso) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage

# ---- Notificações por e-mail ----
# O SMTP é administrado pela tela Configurações > Configuração de E-mail.
# Use uma chave longa e estável em produção; se omitida, será usado JWT_SECRET.
# EMAIL_ENCRYPTION_KEY=

# ---- Integração com WhatsApp ----
# As credenciais são administradas em Configurações > Configuração do WhatsApp.
# Use uma chave longa e estável em produção; se omitida, será usado JWT_SECRET.
# WHATSAPP_ENCRYPTION_KEY=

# ---- Integração com o Multicortex Projetos (tarefas na base do PMO) ----
# Mesma chave do CRM_INTEGRATION_KEY do PMO (openssl rand -base64 48).
# Local: http://host.docker.internal:3333/api/v1 | Produção: rede interna (ex.: http://projetos-backend:3333/api/v1)
# PMO_API_URL=
# PMO_INTEGRATION_KEY=
# Endereço público do PMO (navegador): oportunidade ganha pode virar projeto lá.
# Local: http://localhost:5173 | Produção: https://pmo.multicortex.com.br (padrão do compose de produção)
# PMO_URL=

# ---- Fases futuras ----
# REDIS_URL=

# ---- Rate limit ----
# Requisições por minuto por IP (padrão 300; login fica em 5/min).
# THROTTLE_LIMIT=300
# Proxies à frente do backend (padrão 1; produção: 2 = Nginx de borda + Nginx do app).
# TRUST_PROXY_HOPS=1

# Intervalo (segundos) da sincronização automática de tarefas com o Google Tasks (padrão 120, mínimo 30).
# GOOGLE_TASKS_AUTO_SYNC_INTERVAL_SECONDS=120

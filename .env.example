# ---- Fase 0 (em uso) ----
POSTGRES_USER=multicortex
POSTGRES_PASSWORD=multicortex
POSTGRES_DB=multicortex_crm
DATABASE_URL=postgresql://multicortex:multicortex@postgres:5432/multicortex_crm?schema=public

BACKEND_PORT=3333
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
APP_DOMAIN=localhost
NODE_ENV=development

# ---- Fase 1 (em uso) ----
# Token opaco de refresh nao usa JWT nem segredo proprio (guardado com hash no banco).
JWT_SECRET=troque-este-valor-em-producao
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ---- Fase 3 (em uso) ----
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/app/storage

# ---- Notificações por e-mail ----
# O SMTP é administrado pela tela Configurações > Configuração de E-mail.
# Use uma chave longa e estável em produção; se omitida, será usado JWT_SECRET.
# EMAIL_ENCRYPTION_KEY=

# ---- Integração com WhatsApp ----
# As credenciais são administradas em Configurações > Configuração do WhatsApp.
# Use uma chave longa e estável em produção; se omitida, será usado JWT_SECRET.
# WHATSAPP_ENCRYPTION_KEY=

# ---- Fases futuras ----
# REDIS_URL=

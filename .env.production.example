POSTGRES_USER=multicortex
POSTGRES_PASSWORD=SUBSTITUA_POR_UMA_SENHA_FORTE_E_UNICA
POSTGRES_DB=multicortex_crm

# URL pública, sem barra no final. Exemplo: https://crm.suaempresa.com.br
FRONTEND_URL=https://crm.exemplo.com.br
HTTP_PORT=8081

# Gere com: openssl rand -base64 48
JWT_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_COM_PELO_MENOS_32_CARACTERES
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Integração com o Multicortex Projetos (tarefas na base do PMO): mesma chave do
# CRM_INTEGRATION_KEY do PMO. PMO_API_URL já tem o padrão http://projetos-backend:3333/api/v1.
PMO_INTEGRATION_KEY=
# Endereço público do PMO (padrão https://pmo.multicortex.com.br): converte oportunidade ganha em projeto.
# PMO_URL=

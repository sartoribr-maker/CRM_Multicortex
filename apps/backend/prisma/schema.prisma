// Fase 1: modelos de autenticacao e RBAC (User/Role/Permission).
// Fase 2: tabelas de dominio configuraveis (Stage, Priority, DealSize,
// Source, ProjectType, CustomField) que alimentam Leads/Kanban nas
// proximas fases, em vez de enums fixos no codigo (secao 5 do documento).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  module      String
  description String?

  roles RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  position     String?
  phone        String?
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  ownedLeads         Lead[]               @relation("LeadOwner")
  stageHistoryChanges StageHistoryEntry[]
  uploadedAttachments Attachment[]
  leadActivities     LeadActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Stage {
  id          String  @id @default(uuid())
  name        String
  order       Int     @default(0)
  color       String
  isWonStage  Boolean @default(false)
  isLostStage Boolean @default(false)

  leads             Lead[]
  stageHistoryFrom  StageHistoryEntry[] @relation("StageHistoryFrom")
  stageHistoryTo    StageHistoryEntry[] @relation("StageHistoryTo")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("stages")
}

model Priority {
  id    String @id @default(uuid())
  name  String
  color String
  order Int    @default(0)

  leads Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("priorities")
}

model DealSize {
  id       String   @id @default(uuid())
  name     String
  color    String
  order    Int      @default(0)
  minValue Decimal? @db.Decimal(14, 2)
  maxValue Decimal? @db.Decimal(14, 2)

  leads Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("deal_sizes")
}

model Source {
  id          String  @id @default(uuid())
  name        String
  description String?

  leads Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("sources")
}

model ProjectType {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String?

  leads Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("project_types")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  CURRENCY
}

model CustomField {
  id               String          @id @default(uuid())
  name             String
  type             CustomFieldType
  targetEntity     String          @default("LEAD")
  options          Json?
  isRequired       Boolean         @default(false)
  showInForm       Boolean         @default(true)
  showInKanbanCard Boolean         @default(false)
  showInFilters    Boolean         @default(false)
  order            Int             @default(0)

  values CustomFieldValue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("custom_fields")
}

// Fase 3: Lead/Oportunidade, a entidade central do CRM (secao 5, item 5).

enum LeadPeriodicity {
  PONTUAL
  MENSAL
  TRIMESTRAL
  ANUAL
  RECORRENTE
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

model Lead {
  id String @id @default(uuid())
  name String

  companyName     String?
  companyDocument String?
  companySegment  String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  projectTypeId String?
  projectType   ProjectType? @relation(fields: [projectTypeId], references: [id])

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  priorityId String?
  priority   Priority? @relation(fields: [priorityId], references: [id])

  dealSizeId String?
  dealSize   DealSize? @relation(fields: [dealSizeId], references: [id])

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id])

  successProbability Int?
  estimatedValue      Decimal?        @db.Decimal(14, 2)
  periodicity         LeadPeriodicity @default(PONTUAL)
  expectedCloseDate   DateTime?

  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  description String?

  status     LeadStatus @default(OPEN)
  lossReason String?

  stageEnteredAt DateTime @default(now())

  customFieldValues CustomFieldValue[]
  stageHistory      StageHistoryEntry[]
  attachments       Attachment[]
  activities        LeadActivity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("leads")
}

model CustomFieldValue {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id])

  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, customFieldId])
  @@map("custom_field_values")
}

model StageHistoryEntry {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   Stage?  @relation("StageHistoryFrom", fields: [fromStageId], references: [id])

  toStageId String
  toStage   Stage  @relation("StageHistoryTo", fields: [toStageId], references: [id])

  changedByUserId String
  changedByUser   User   @relation(fields: [changedByUserId], references: [id])

  timeInPreviousStageSeconds Int?
  reason                     String?

  createdAt DateTime @default(now())

  @@map("stage_history_entries")
}

model Attachment {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedByUserId String
  uploadedByUser   User   @relation(fields: [uploadedByUserId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("attachments")
}

enum LeadActivityType {
  CREATED
  FIELD_UPDATED
  STAGE_CHANGED
  COMMENT
  ATTACHMENT_ADDED
}

model LeadActivity {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type     LeadActivityType
  message  String
  metadata Json?

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@map("lead_activities")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  actorUserId  String?
  targetType   String?
  targetId     String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

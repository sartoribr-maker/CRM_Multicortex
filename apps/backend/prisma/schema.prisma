// Fase 1: modelos de autenticacao e RBAC (User/Role/Permission).
// Fase 2: tabelas de dominio configuraveis (Stage, Priority, DealSize,
// Source, ProjectType, CustomField) que alimentam Leads/Kanban nas
// proximas fases, em vez de enums fixos no codigo (secao 5 do documento).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  module      String
  description String?

  roles RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String     @id @default(uuid())
  name         String
  email        String     @unique
  passwordHash String
  avatarUrl    String?
  position     String?
  phone        String?
  status       UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens      RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Stage {
  id          String  @id @default(uuid())
  name        String
  order       Int     @default(0)
  color       String
  isWonStage  Boolean @default(false)
  isLostStage Boolean @default(false)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("stages")
}

model Priority {
  id    String @id @default(uuid())
  name  String
  color String
  order Int    @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("priorities")
}

model DealSize {
  id       String   @id @default(uuid())
  name     String
  color    String
  order    Int      @default(0)
  minValue Decimal? @db.Decimal(14, 2)
  maxValue Decimal? @db.Decimal(14, 2)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("deal_sizes")
}

model Source {
  id          String  @id @default(uuid())
  name        String
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("sources")
}

model ProjectType {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("project_types")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  CURRENCY
}

model CustomField {
  id               String          @id @default(uuid())
  name             String
  type             CustomFieldType
  targetEntity     String          @default("LEAD")
  options          Json?
  isRequired       Boolean         @default(false)
  showInForm       Boolean         @default(true)
  showInKanbanCard Boolean         @default(false)
  showInFilters    Boolean         @default(false)
  order            Int             @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("custom_fields")
}

model AuditLog {
  id           String   @id @default(uuid())
  action       String
  actorUserId  String?
  targetType   String?
  targetId     String?
  metadata     Json?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

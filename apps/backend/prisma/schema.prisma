// Fase 1: modelos de autenticacao e RBAC (User/Role/Permission).
// Fase 2: tabelas de dominio configuraveis (Stage, Priority, DealSize,
// Source, ProjectType, CustomField) que alimentam Leads/Kanban nas
// proximas fases, em vez de enums fixos no codigo (secao 5 do documento).

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model EmailSettings {
  id                String   @id @default("default")
  enabled           Boolean  @default(false)
  host              String   @default("smtp.gmail.com")
  port              Int      @default(587)
  secure            Boolean  @default(false)
  username          String   @default("sartori.br@gmail.com")
  passwordEncrypted String?
  fromEmail         String   @default("sartori.br@gmail.com")
  fromName          String   @default("Multicortex CRM")
  updatedAt         DateTime @updatedAt
  updatedBy         String?

  @@map("email_settings")
}

model WhatsAppSettings {
  id                     String   @id @default("default")
  enabled                Boolean  @default(false)
  apiVersion             String   @default("v23.0")
  phoneNumberId          String   @default("")
  businessAccountId      String   @default("")
  accessTokenEncrypted   String?
  languageCode           String   @default("pt_BR")
  testTemplate           String   @default("hello_world")
  leadCreatedTemplate    String   @default("")
  leadStageTemplate      String   @default("")
  taskCreatedTemplate    String   @default("")
  taskUpdatedTemplate    String   @default("")
  testPhone              String   @default("")
  notifyLeadCreated      Boolean  @default(true)
  notifyLeadStageChanged Boolean  @default(true)
  notifyTaskCreated      Boolean  @default(true)
  notifyTaskUpdated      Boolean  @default(true)
  updatedAt              DateTime @updatedAt
  updatedBy              String?

  @@map("whatsapp_settings")
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

model Role {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?
  isSystem    Boolean @default(false)

  users       User[]
  permissions RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  module      String
  description String?

  roles RolePermission[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("permissions")
}

model RolePermission {
  id           String @id @default(uuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id                 String     @id @default(uuid())
  name               String
  email              String     @unique
  passwordHash       String
  mustChangePassword Boolean    @default(false)
  avatarUrl          String?
  position           String?
  phone              String?
  status             UserStatus @default(ACTIVE)

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]

  ownedLeads              Lead[]              @relation("LeadOwner")
  leadAssignments         LeadAssignee[]
  stageHistoryChanges     StageHistoryEntry[]
  uploadedAttachments     Attachment[]
  leadActivities          LeadActivity[]
  assignedTasks           Task[]              @relation("TaskAssignee")
  taskAssignments         TaskAssignee[]
  uploadedTaskAttachments TaskAttachment[]
  taskHistoryActions      TaskHistoryEntry[]
  createdTasks            Task[]              @relation("TaskCreator")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("users")
}

enum PartnerType {
  REFERRAL
  TECHNOLOGY
  CONSULTING
  CHANNEL
  OTHER
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Partner {
  id                   String        @id @default(uuid())
  name                 String
  legalName            String?
  type                 PartnerType   @default(REFERRAL)
  document             String?       @unique
  contactName          String?
  email                String?
  phone                String?
  website              String?
  commissionPercentage Decimal?      @db.Decimal(5, 2)
  status               PartnerStatus @default(ACTIVE)
  notes                String?

  leads          Lead[] @relation("LeadReferralPartner")
  technicalLeads Lead[] @relation("LeadTechnicalPartner")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("partners")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@map("password_reset_tokens")
}

model Stage {
  id          String  @id @default(uuid())
  name        String
  order       Int     @default(0)
  color       String
  isWonStage  Boolean @default(false)
  isLostStage Boolean @default(false)

  leads            Lead[]
  stageHistoryFrom StageHistoryEntry[] @relation("StageHistoryFrom")
  stageHistoryTo   StageHistoryEntry[] @relation("StageHistoryTo")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("stages")
}

model Priority {
  id    String @id @default(uuid())
  name  String
  color String
  order Int    @default(0)

  leads Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("priorities")
}

model DealSize {
  id       String   @id @default(uuid())
  name     String
  color    String
  order    Int      @default(0)
  minValue Decimal? @db.Decimal(14, 2)
  maxValue Decimal? @db.Decimal(14, 2)

  leads Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("deal_sizes")
}

model Source {
  id          String  @id @default(uuid())
  name        String
  description String?

  leads Lead[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("sources")
}

model Segment {
  id          String  @id @default(uuid())
  name        String  @unique
  description String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("segments")
}

model ProjectType {
  id          String  @id @default(uuid())
  name        String
  description String?
  category    String?

  leads           Lead[]               @relation("LeadPrimaryProjectType")
  leadAssignments LeadProjectType[]
  services        ProjectTypeService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("project_types")
}

enum ServiceBillingUnit {
  MONTH
  HOUR
  ONE_TIME
}

model Service {
  id          String             @id @default(uuid())
  name        String             @unique
  description String?
  price       Decimal            @db.Decimal(14, 2)
  billingUnit ServiceBillingUnit

  projectTypes ProjectTypeService[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("services")
}

model ProjectTypeService {
  projectTypeId String
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)
  serviceId     String
  service       Service     @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@id([projectTypeId, serviceId])
  @@index([serviceId])
  @@map("project_type_services")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SINGLE_SELECT
  MULTI_SELECT
  BOOLEAN
  CURRENCY
}

model CustomField {
  id               String          @id @default(uuid())
  name             String
  type             CustomFieldType
  targetEntity     String          @default("LEAD")
  options          Json?
  isRequired       Boolean         @default(false)
  showInForm       Boolean         @default(true)
  showInKanbanCard Boolean         @default(false)
  showInFilters    Boolean         @default(false)
  order            Int             @default(0)

  values CustomFieldValue[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@map("custom_fields")
}

// Fase 3: Lead/Oportunidade, a entidade central do CRM (secao 5, item 5).

enum LeadPeriodicity {
  PONTUAL
  MENSAL
  TRIMESTRAL
  ANUAL
  RECORRENTE
}

enum LeadStatus {
  OPEN
  WON
  LOST
}

enum LeadLine {
  ENTERPRISE
  PRIVACY
  MIX
}

model Lead {
  id           String    @id @default(uuid())
  businessCode String?   @unique
  line         LeadLine?
  name         String

  companyName     String?
  companyDocument String?
  companySegment  String?

  contactName  String?
  contactEmail String?
  contactPhone String?

  projectTypeId String?
  projectType   ProjectType?      @relation("LeadPrimaryProjectType", fields: [projectTypeId], references: [id])
  projectTypes  LeadProjectType[]

  stageId String
  stage   Stage  @relation(fields: [stageId], references: [id])

  priorityId String?
  priority   Priority? @relation(fields: [priorityId], references: [id])

  dealSizeId String?
  dealSize   DealSize? @relation(fields: [dealSizeId], references: [id])

  sourceId String?
  source   Source? @relation(fields: [sourceId], references: [id])

  partnerId String?
  partner   Partner? @relation("LeadReferralPartner", fields: [partnerId], references: [id])

  technicalPartnerId    String?
  technicalPartner      Partner? @relation("LeadTechnicalPartner", fields: [technicalPartnerId], references: [id])
  technicalServiceValue Decimal? @db.Decimal(14, 2)

  successProbability Int?
  capexValue         Decimal?        @db.Decimal(14, 2)
  opexValue          Decimal?        @db.Decimal(14, 2)
  estimatedValue     Decimal?        @db.Decimal(14, 2)
  periodicity        LeadPeriodicity @default(PONTUAL)
  expectedCloseDate  DateTime?

  ownerId String
  owner   User   @relation("LeadOwner", fields: [ownerId], references: [id])

  description String?

  status     LeadStatus @default(OPEN)
  lossReason String?

  stageEnteredAt DateTime @default(now())

  customFieldValues CustomFieldValue[]
  stageHistory      StageHistoryEntry[]
  attachments       Attachment[]
  activities        LeadActivity[]
  tasks             Task[]
  assignees         LeadAssignee[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  deletedAt DateTime?

  @@index([technicalPartnerId])
  @@index([line])
  @@map("leads")
}

model LeadAssignee {
  leadId     String
  lead       Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@id([leadId, userId])
  @@index([userId])
  @@map("lead_assignees")
}

model LeadProjectType {
  leadId        String
  lead          Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  projectTypeId String
  projectType   ProjectType @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)

  @@id([leadId, projectTypeId])
  @@index([projectTypeId])
  @@map("lead_project_types")
}

model Task {
  id          String       @id @default(uuid())
  title       String
  description String?
  status      TaskStatus   @default(TODO)
  priority    TaskPriority @default(MEDIUM)
  dueDate     DateTime
  completedAt DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  assigneeId         String
  assignee           User               @relation("TaskAssignee", fields: [assigneeId], references: [id])
  assigneeAssignedAt DateTime           @default(now())
  assignees          TaskAssignee[]
  attachments        TaskAttachment[]
  history            TaskHistoryEntry[]

  createdByUserId String
  createdByUser   User   @relation("TaskCreator", fields: [createdByUserId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([assigneeId, status, dueDate])
  @@map("tasks")
}

model TaskAssignee {
  taskId     String
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedAt DateTime @default(now())
  assignedBy String?

  @@id([taskId, userId])
  @@index([userId])
  @@map("task_assignees")
}

model TaskAttachment {
  id String @id @default(uuid())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedByUserId String
  uploadedByUser   User   @relation(fields: [uploadedByUserId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([taskId])
  @@map("task_attachments")
}

enum TaskHistoryType {
  DEADLINE_EXTENDED
  TRANSFERRED
}

model TaskHistoryEntry {
  id       String          @id @default(uuid())
  taskId   String
  task     Task            @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type     TaskHistoryType
  reason   String
  metadata Json

  actorUserId String
  actorUser   User   @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([taskId, createdAt])
  @@map("task_history_entries")
}

model CustomFieldValue {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id])

  value Json

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([leadId, customFieldId])
  @@map("custom_field_values")
}

model StageHistoryEntry {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fromStageId String?
  fromStage   Stage?  @relation("StageHistoryFrom", fields: [fromStageId], references: [id])

  toStageId String
  toStage   Stage  @relation("StageHistoryTo", fields: [toStageId], references: [id])

  changedByUserId String
  changedByUser   User   @relation(fields: [changedByUserId], references: [id])

  timeInPreviousStageSeconds Int?
  reason                     String?

  createdAt DateTime @default(now())

  @@map("stage_history_entries")
}

model Attachment {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  sizeBytes  Int
  storageKey String

  uploadedByUserId String
  uploadedByUser   User   @relation(fields: [uploadedByUserId], references: [id])

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@map("attachments")
}

enum LeadActivityType {
  CREATED
  FIELD_UPDATED
  STAGE_CHANGED
  COMMENT
  ATTACHMENT_ADDED
}

model LeadActivity {
  id String @id @default(uuid())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type     LeadActivityType
  message  String
  metadata Json?

  actorUserId String?
  actorUser   User?   @relation(fields: [actorUserId], references: [id])

  createdAt DateTime @default(now())

  @@map("lead_activities")
}

model AuditLog {
  id          String  @id @default(uuid())
  action      String
  actorUserId String?
  targetType  String?
  targetId    String?
  metadata    Json?

  createdAt DateTime @default(now())

  @@map("audit_logs")
}

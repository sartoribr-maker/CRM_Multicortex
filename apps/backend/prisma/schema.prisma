// Fase 0: schema minimo, apenas provando a conexao com o PostgreSQL.
// As entidades de negocio (User, Role, Permission, Lead, etc.) entram nas
// Fases 1 e 2, conforme o plano de execucao do Multicortex CRM, substituindo
// o modelo placeholder abaixo.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Placeholder da Fase 0 - remover quando as entidades de negocio forem criadas.
model SystemStatus {
  id        String   @id @default(uuid())
  checkedAt DateTime @default(now())
}

#!/bin/bash

set -e

APP_DIR="/opt/multicortex/crm"
ENV_FILE=".env.production"
COMPOSE_FILE="infra/docker-compose.prod.yml"

echo
echo "=========================================="
echo "     DEPLOY CRM MULTICORTEX"
echo "=========================================="
echo

cd "$APP_DIR"

echo "1/7 - Buscando nova versão no GitHub..."
git fetch origin master

echo
echo "2/7 - Atualizando código..."
git reset --hard origin/master

echo
echo "3/7 - Construindo aplicação..."
docker compose \
  --env-file "$ENV_FILE" \
  -f "$COMPOSE_FILE" \
  build

echo
echo "4/7 - Atualizando containers..."
docker compose \
  --env-file "$ENV_FILE" \
  -f "$COMPOSE_FILE" \
  up -d

echo
echo "5/7 - Limpando imagens antigas e cache de build..."
# Remove só imagens órfãs (sem tag) e cache com mais de 7 dias.
# Imagens com tag (rollbacks) e volumes são preservados.
docker image prune -f || true
docker builder prune -f --filter until=168h || true
df -h /docker | tail -1

echo
echo "6/7 - Aguardando inicialização..."
sleep 20

echo
echo "7/7 - Verificando serviços..."
docker compose \
  --env-file "$ENV_FILE" \
  -f "$COMPOSE_FILE" \
  ps

echo
echo "Testando API..."

if curl -fsS -H 'Host: crm.multicortex.com.br' \
  http://127.0.0.1/api/v1/health > /dev/null; then
    echo
    echo "=========================================="
    echo " DEPLOY REALIZADO COM SUCESSO!"
    echo " CRM: https://crm.multicortex.com.br"
    echo "=========================================="
    echo
else
    echo
    echo "=========================================="
    echo " ATENCAO: API NAO RESPONDEU AO HEALTHCHECK"
    echo " Verifique os logs dos containers."
    echo "=========================================="
    echo
    exit 1
fi
